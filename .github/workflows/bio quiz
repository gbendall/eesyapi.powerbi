const AnimatedCounter = ({ value, duration = 1000 }) => {
  const [displayValue, setDisplayValue] = useState(0);
  
  useEffect(() => {
    const startTime = Date.now();
    const startValue = displayValue;
    
    const updateValue = () => {
      const elapsed = Date.now() - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      const currentValue = Math.floor(startValue + (value - startValue) * progress);
      setDisplayValue(currentValue);
      
      if (progress < 1) {
        requestAnimationFrame(updateValue);
      }
    };
    
    updateValue();
  }, [value, duration]);
  
  return <span>{displayValue}</span>;
};

// Main Quiz Component
export default function EnhancedBiologyQuiz() {
  const [studentName, setStudentName] = useState('');
  const [started, setStarted] = useState(false);
  const [selectedTopics, setSelectedTopics] = useState(['Enzymes']);
  const [difficulty, setDifficulty] = useState('Mixed');
  const [questionCount, setQuestionCount] = useState(20); // Fixed at 20 questions
  const [aiQuestionRatio, setAiQuestionRatio] = useState(0.5); // 50% AI-generated questions by default
  const [studyMode, setStudyMode] = useState(false);
  const [showHints, setShowHints] = useState(true);
  
  const [currentQuestionIndex, setCurrentQuestionIndex] = useState(0);
  const [currentQuestion, setCurrentQuestion] = useState(null);
  const [questionSet, setQuestionSet] = useState([]);
  const [selectedAnswer, setSelectedAnswer] = useState(null);
  const [showFeedback, setShowFeedback] = useState(false);
  const [showHint, setShowHint] = useState(false);
  const [score, setScore] = useState(0);
  const [timeLeft, setTimeLeft] = useState(null);
  const [timedMode, setTimedMode] = useState(false);
  const [quizComplete, setQuizComplete] = useState(false);
  const [userAnswers, setUserAnswers] = useState([]);
  const [showExplanation, setShowExplanation] = useState(false);
  const [performanceHistory, setPerformanceHistory] = useState([]);
  const [aiGenerator] = useState(new AIQuestionGenerator());

  // Enhanced question generation with AI integration
  const generateQuestionSet = () => {
    let allQuestions = [];
    const totalQuestions = 20; // Always 20 questions
    const aiQuestionCount = Math.floor(totalQuestions * aiQuestionRatio);
    const presetQuestionCount = totalQuestions - aiQuestionCount;
    
    // Get preset questions from question bank
    selectedTopics.forEach(topic => {
      const topicQuestions = questionBank[topic] || [];
      if (difficulty !== 'Mixed') {
        allQuestions = [...allQuestions, ...topicQuestions.filter(q => q.difficulty === difficulty)];
      } else {
        allQuestions = [...allQuestions, ...topicQuestions];
      }
    });

    // Shuffle and limit preset questions
    const shuffledPreset = [...allQuestions].sort(() => Math.random() - 0.5);
    const selectedPreset = shuffledPreset.slice(0, presetQuestionCount);

    // Generate AI questions to fill the gap
    const aiQuestions = [];
    const questionsPerTopic = Math.ceil(aiQuestionCount / selectedTopics.length);
    
    selectedTopics.forEach(topic => {
      const spec = specificationTopics[topic];
      if (!spec) return;
      
      for (let i = 0; i < questionsPerTopic && aiQuestions.length < aiQuestionCount; i++) {
        const keyPoint = spec.keyPoints[Math.floor(Math.random() * spec.keyPoints.length)];
        const questionDifficulty = difficulty === 'Mixed' 
          ? ['Easy', 'Medium', 'Hard'][Math.floor(Math.random() * 3)]
          : difficulty;
          
        const aiQuestion = aiGenerator.generateQuestion(topic, questionDifficulty, keyPoint);
        if (aiQuestion) {
          aiQuestions.push(aiQuestion);
        }
      }
    });

    // Combine and shuffle all questions
    const finalQuestions = [...selectedPreset, ...aiQuestions];
    
    // Ensure exactly 20 questions
    const shuffled = finalQuestions.sort(() => Math.random() - 0.5);
    return shuffled.slice(0, 20);
  };

  // Start quiz with enhanced AI generation
  const startQuiz = () => {
    aiGenerator.reset(); // Reset AI generator for new quiz
    const questions = generateQuestionSet();
    
    if (questions.length < 20) {
      alert(`Not enough questions available. Found ${questions.length} questions, but need exactly 20. Please select more topics or adjust difficulty.`);
      return;
    }
    
    setQuestionSet(questions);
    setCurrentQuestion(questions[0]);
    setCurrentQuestionIndex(0);
    setScore(0);
    setUserAnswers([]);
    setSelectedAnswer(null);
    setShowFeedback(false);
    setShowHint(false);
    setShowExplanation(false);
    setQuizComplete(false);
    setStarted(true);
    
    if (timedMode && !studyMode) {
      setTimeLeft(20 * 45); // 20 questions × 45 seconds each
    }
  };

  // Handle answer selection
  const handleAnswerSelect = (answer) => {
    if (showFeedback && !studyMode) return;
    setSelectedAnswer(answer);
    
    if (studyMode) {
      submitAnswer(answer);
    }
  };

  // Submit answer with enhanced feedback
  const submitAnswer = (answer = selectedAnswer) => {
    if (!answer && !timedMode) return;
    
    const finalAnswer = answer || "No answer";
    const isCorrect = finalAnswer === currentQuestion.correct;
    
    const answerData = {
      question: currentQuestion,
      userAnswer: finalAnswer,
      correct: isCorrect,
      timestamp: new Date().toISOString(),
      timeSpent: timedMode ? (45 - (timeLeft % 45)) : null
    };
    
    setUserAnswers([...userAnswers, answerData]);
    
    if (isCorrect) {
      setScore(score + 1);
    }
    
    setShowFeedback(true);
    setShowExplanation(true);
    
    if (!studyMode) {
      setTimeout(() => {
        nextQuestion();
      }, 4000);
    }
  };

  // Next question
  const nextQuestion = () => {
    const nextIndex = currentQuestionIndex + 1;
    
    if (nextIndex >= questionSet.length) {
      completeQuiz();
    } else {
      setCurrentQuestionIndex(nextIndex);
      setCurrentQuestion(questionSet[nextIndex]);
      setSelectedAnswer(null);
      setShowFeedback(false);
      setShowHint(false);
      setShowExplanation(false);
    }
  };

  // Complete quiz
  const completeQuiz = () => {
    setQuizComplete(true);
  };

  // Reset quiz
  const resetQuiz = () => {
    setStarted(false);
    setQuizComplete(false);
    setCurrentQuestionIndex(0);
    setScore(0);
    setUserAnswers([]);
    setTimeLeft(null);
    setShowHint(false);
    setShowExplanation(false);
  };

  // Format time
  const formatTime = (seconds) => {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
