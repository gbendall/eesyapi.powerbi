// AI Question Generator Class
class AIQuestionGenerator {
  constructor() {
    this.usedQuestionIds = new Set();
  }

  generateQuestion(topic, difficulty, keyPoint) {
    const spec = specificationTopics[topic];
    if (!spec) return null;

    // Select appropriate template based on difficulty
    const templates = Object.entries(questionTemplates).filter(([_, template]) => 
      template.difficulty === difficulty || difficulty === 'Mixed'
    );
    
    if (templates.length === 0) return null;
    
    const [templateName, template] = templates[Math.floor(Math.random() * templates.length)];
    
    // Generate unique ID
    const questionId = `AI_${topic}_${templateName}_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
    
    if (this.usedQuestionIds.has(questionId)) {
      return this.generateQuestion(topic, difficulty, keyPoint); // Retry with different ID
    }
    
    this.usedQuestionIds.add(questionId);

    // Generate question based on template and topic
    return this.createQuestionFromTemplate(questionId, topic, templateName, template, keyPoint, spec);
  }

  createQuestionFromTemplate(id, topic, templateName, template, keyPoint, spec) {
    const questionData = this.getQuestionContent(topic, templateName, keyPoint, spec);
    
    return {
      id,
      question: questionData.question,
      options: this.shuffleArray([...questionData.options]),
      correct: questionData.correct,
      difficulty: template.difficulty === 'Mixed' ? ['Easy', 'Medium', 'Hard'][Math.floor(Math.random() * 3)] : template.difficulty,
      explanation: questionData.explanation,
      topic,
      hint: questionData.hint,
      isAIGenerated: true,
      generatedAt: new Date().toISOString()
    };
  }

  getQuestionContent(topic, templateName, keyPoint, spec) {
    // This is where we'd integrate with an actual AI service
    // For now, we'll use smart templates with topic-specific content
    
    const contentMaps = {
      "Enzymes": {
        "definition": {
          question: "What is enzyme specificity?",
          correct: "The ability of an enzyme to bind only to specific substrates due to the shape and chemical properties of its active site",
          options: [
            "The ability of an enzyme to bind only to specific substrates due to the shape and chemical properties of its active site",
            "The ability of an enzyme to work at any temperature or pH condition",
            "The speed at which an enzyme catalyzes all types of biochemical reactions",
            "The concentration of enzyme needed to achieve maximum reaction rate"
          ],
          explanation: "Enzyme specificity is determined by the precise three-dimensional structure of the active site, which complements the shape and chemical properties of specific substrates through the lock-and-key or induced-fit models.",
          hint: "Think about why enzymes only work with certain substrates and not others."
        },
        "comparison": {
          question: "What is the main difference between competitive and non-competitive inhibition?",
          correct: "Competitive inhibitors bind to the active site, while non-competitive inhibitors bind to allosteric sites",
          options: [
            "Competitive inhibitors bind to the active site, while non-competitive inhibitors bind to allosteric sites",
            "Competitive inhibitors are permanent, while non-competitive inhibitors are reversible",
            "Competitive inhibitors increase enzyme activity, while non-competitive inhibitors decrease it",
            "Competitive inhibitors work at high temperatures, while non-competitive inhibitors work at low temperatures"
          ],
          explanation: "Competitive inhibitors compete directly with the substrate for the active site, while non-competitive inhibitors bind to a different site (allosteric site) and change the enzyme's shape, affecting its activity.",
          hint: "Consider where each type of inhibitor binds on the enzyme molecule."
        }
      },
      "Cell Division": {
        "definition": {
          question: "What is the purpose of the G1/S checkpoint in the cell cycle?",
          correct: "To ensure DNA is undamaged and the cell is ready for DNA replication",
          options: [
            "To ensure DNA is undamaged and the cell is ready for DNA replication",
            "To check that all chromosomes are properly attached to spindle fibers",
            "To verify that cytokinesis has completed successfully",
            "To ensure the cell has reached the appropriate size for division"
          ],
          explanation: "The G1/S checkpoint (restriction point) monitors DNA integrity and ensures the cell has adequate resources before proceeding to S phase where DNA replication occurs.",
          hint: "Think about what needs to be checked before DNA replication begins."
        }
      },
      "Photosynthesis": {
        "application": {
          question: "In a greenhouse with high light intensity and temperature, what would limit the rate of photosynthesis?",
          correct: "Carbon dioxide concentration",
          options: [
            "Carbon dioxide concentration",
            "Light intensity",
            "Temperature",
            "Water availability"
          ],
          explanation: "When light intensity and temperature are already high and optimal, CO2 concentration becomes the limiting factor as plants cannot photosynthesize faster than CO2 can be absorbed and processed.",
          hint: "Consider which factors are already optimal in this scenario."
        }
      }
    };

    const topicContent = contentMaps[topic];
    if (topicContent && topicContent[templateName]) {
      return topicContent[templateName];
    }

    // Fallback to basic template if specific content not available
    return this.generateBasicQuestion(topic, keyPoint);
  }

  generateBasicQuestion(topic, keyPoint) {
    return {
      question: `Which statement about ${keyPoint.toLowerCase()} is correct?`,
      correct: `The primary characteristic of ${keyPoint.toLowerCase()} in ${topic.toLowerCase()}`,
      options: [
        `The primary characteristic of ${keyPoint.toLowerCase()} in ${topic.toLowerCase()}`,
        `An incorrect but plausible statement about ${keyPoint.toLowerCase()}`,
        `A statement confusing ${keyPoint.toLowerCase()} with another concept`,
        `A completely unrelated statement about ${topic.toLowerCase()}`
      ],
      explanation: `${keyPoint} is a fundamental concept in ${topic} that students should understand thoroughly for A-Level Biology.`,
      hint: `Consider the key characteristics and functions related to ${keyPoint.toLowerCase()}.`
    };
  }

  shuffleArray(array) {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  reset() {
    this.usedQuestionIds.clear();
  }
}

